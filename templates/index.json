    "custom_liquid_chessboard": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"page-width\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem;align-items:center;\"><div><p style=\"letter-spacing:.18em;text-transform:uppercase;margin:0 0 1rem;\">The CastleyCrown board</p><h2 style=\"margin:0 0 1rem;font-size:clamp(2.4rem,5vw,5.2rem);\">Every purchase should feel like a brilliant move.</h2><p style=\"margin:0;max-width:58rem;\">Build a home setup, prep for club night, or gift a future grandmaster with chess goods arranged around strategy, quality, and presentation.</p></div><div aria-hidden=\"true\" style=\"aspect-ratio:1;border:8px solid currentColor;border-radius:18px;background-color:#f7f0df;background-image:linear-gradient(45deg,#201a24 25%,transparent 25%),linear-gradient(-45deg,#201a24 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#201a24 75%),linear-gradient(-45deg,transparent 75%,#201a24 75%);background-size:25% 25%;background-position:0 0,0 12.5%,12.5% -12.5%,-12.5% 0;box-shadow:0 2rem 4rem rgba(0,0,0,.25);\"></div></div>",
        "color_scheme": "scheme-5",
